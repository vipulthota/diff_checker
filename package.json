{
  "name": "diffspace",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "description": "DiffSpace - privacy-first, browser-only comparison tool for text, code, documents, images and spreadsheets",
  "dependencies": {
